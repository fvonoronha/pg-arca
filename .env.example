# pg-arca - configuração. Copie para .env e preencha. Tudo aqui é lido do ambiente do container.
# Senhas/chaves também podem vir de arquivo (Docker secrets): use VARIAVEL_FILE=/run/secrets/...

# =========================================================== Postgres (de onde copiar)
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=troque-esta-senha
# PGPASSWORD_FILE=/run/secrets/pg_password

# "all" = todos os bancos (menos postgres e modelos) ou uma lista: "biblioteca,site"
BACKUP_DATABASES=all
# Papéis/usuários e configurações globais (pg_dumpall --globals-only). Precisa de superusuário.
BACKUP_GLOBALS=true
# Nome deste servidor nas pastas do armazenamento (útil com vários servidores no mesmo bucket).
BACKUP_NAME=producao
# Compressão do pg_dump: 0-9 (gzip), ou "zstd:6" / "lz4" no Postgres 16+.
BACKUP_COMPRESSION=6
# Opções extras do pg_dump, ex.: "--exclude-table-data=logs_*"
PG_DUMP_EXTRA_ARGS=

# =========================================================== Agenda
# Formato cron (minuto hora dia mês dia-da-semana). Padrão: todo dia às 3h.
BACKUP_SCHEDULE=0 3 * * *
TZ=America/Sao_Paulo
# Faz um backup assim que o container sobe (além do agendado).
BACKUP_ON_STARTUP=false

# =========================================================== Armazenamento (para onde enviar)
# aws | r2 | s3 (qualquer compatível: Backblaze B2, Wasabi, MinIO, DigitalOcean Spaces...) |
# local (pasta/volume) | rclone (qualquer serviço do rclone: Google Drive, SFTP, Azure...)
STORAGE_PROVIDER=aws
STORAGE_BUCKET=meu-bucket-de-backups
# Pasta dentro do bucket
STORAGE_PREFIX=postgres-backups
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/storage_secret

# --- aws
STORAGE_REGION=sa-east-1
# Tier (classe de armazenamento). Para backup: GLACIER_IR (barato e restaura na hora). Ver README.
# STANDARD | STANDARD_IA | ONEZONE_IA | GLACIER_IR | INTELLIGENT_TIERING
# (GLACIER e DEEP_ARCHIVE são ainda mais baratos, mas o arquivo precisa ser "descongelado" por
#  horas antes de restaurar - não recomendado aqui.)
STORAGE_CLASS=GLACIER_IR

# --- r2 (Cloudflare): classes STANDARD ou STANDARD_IA
# STORAGE_R2_ACCOUNT_ID=

# --- s3 compatível (B2, Wasabi, MinIO...)
# STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# STORAGE_S3_PROVIDER=Other   # ou: Minio, Wasabi, DigitalOcean, Backblaze... (nomes do rclone)
# STORAGE_FORCE_PATH_STYLE=true

# --- local
# STORAGE_PATH=/backups

# --- rclone (qualquer serviço): descreva o remoto "arca" com RCLONE_CONFIG_ARCA_*
# Exemplo SFTP:
# RCLONE_CONFIG_ARCA_TYPE=sftp
# RCLONE_CONFIG_ARCA_HOST=backup.exemplo.com
# RCLONE_CONFIG_ARCA_USER=backup
# RCLONE_CONFIG_ARCA_KEY_FILE=/run/secrets/ssh_key
# STORAGE_PATH=/home/backup

# =========================================================== Retenção
# Apagar backups com mais de N dias (0 = não apaga; recomendado: regra de ciclo de vida no bucket,
# ver README). Os BACKUP_KEEP_MIN mais novos de cada banco nunca são apagados.
BACKUP_RETENTION_DAYS=0
BACKUP_KEEP_MIN=3

# =========================================================== Criptografia (recomendado)
# Chave(s) PÚBLICA(s) do age (age1...), separadas por vírgula. Gere com: age-keygen -o chave.txt
# A chave PRIVADA (AGE-SECRET-KEY-...) NÃO fica aqui: guarde num cofre de senhas. Ela só é usada
# para restaurar (AGE_IDENTITY ou AGE_IDENTITY_FILE, só no momento da restauração).
BACKUP_ENCRYPTION_RECIPIENTS=

# =========================================================== Aviso
# Monitor "Push" do Uptime Kuma: recebe status=up (sucesso) ou status=down (falha) a cada backup.
HEALTHCHECK_URL=
